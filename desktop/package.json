{
  "name": "assistente-personale-desktop",
  "version": "1.0.0",
  "description": "Assistente Personale — versione PC (Electron)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.assistente.personale.desktop",
    "productName": "Assistente Personale",
    "files": [
      "main.js",
      "preload.js",
      "../www/**/*"
    ],
    "directories": { "output": "dist" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" },
    "mac": { "target": "dmg" }
  }
}
